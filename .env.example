# ---------------------------------------------------------------------------
# Corporate HR & Payroll Portal - Environment Configuration
# Copy this file to `.env` and replace the placeholder values.
# NEVER commit the real `.env` file to source control.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# --- Session / JWT ---------------------------------------------------------
# High-entropy secret used to sign session tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Short-lived sessions (PRD: aggressively expires after inactivity, e.g. 15m)
JWT_EXPIRES_IN=15m
# Session token cookie name
COOKIE_NAME=hrp_session

# --- Server-side Pepper ----------------------------------------------------
# Static high-entropy secret, stored ONLY in the environment, never in the DB.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PEPPER=replace-with-a-long-random-pepper

# --- Database --------------------------------------------------------------
# Path to the SQLite database file, relative to the project root.
DATABASE_FILE=./data/payroll.db

# --- Corporate Identity ----------------------------------------------------
# OPTIONAL: restrict registration to a single email domain. Leave blank (the
# default) to accept any valid email address.
# Example: CORPORATE_EMAIL_DOMAIN=acme-corp.com
CORPORATE_EMAIL_DOMAIN=

# --- SMTP (OTP delivery) ---------------------------------------------------
# Leave SMTP_HOST blank in development: OTP codes are then written to the
# server console instead of being emailed (a dev "console" transport).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HR Payroll Portal <no-reply@company.com>"

# --- HTTPS email API (recommended when outbound SMTP is blocked) -----------
# Preferred over SMTP when set. Free on https://resend.com and works on hosts
# that block SMTP ports (e.g. Render's free tier). Without a verified domain the
# shared test sender below can only email the Resend account owner's address.
RESEND_API_KEY=
MAIL_FROM="HR Payroll Portal <onboarding@resend.dev>"

# --- One-Time Passwords (email verification + login 2FA) -------------------
OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev only: when SMTP_HOST is blank, echo the OTP to the browser console/hint.
# Ignored in production and whenever SMTP_HOST is set.
OTP_DEV_ECHO=true

# --- First-run HR bootstrap ------------------------------------------------
# Optional shared secret required by the /setup page when creating the first
# HR administrator. Leave blank to require only the "no HR exists yet" guard.
SETUP_TOKEN=
